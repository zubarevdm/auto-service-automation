# Скопировать в /opt/callcatch/.env и заполнить

# --- обязательное ---
CC_WEBHOOK_TOKEN=сгенерируйте-длинный-случайный-токен
CC_PORT=8040

# --- SMS через МТС Exolve (рекомендуется: один поставщик с телефонией) ---
CC_SMS_PROVIDER=exolve
CC_EXOLVE_API_KEY=ключ-из-ЛК-Exolve
CC_EXOLVE_NUMBER=79XXXXXXXXX

# --- либо SMS.ru (альтернатива) ---
# CC_SMS_PROVIDER=smsru
# CC_SMSRU_API_ID=...
# CC_SMS_SENDER=...

# --- уведомления администратору сервиса в Telegram (опционально) ---
# CC_TG_TOKEN=токен-бота
# CC_TG_CHAT=chat_id
